DB_HOST=your-tidb-host
DB_PORT=4000
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=aurora_hr
DB_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
PORT=4001

# Employee documents — private Backblaze B2 storage.
# When these are unset, documents fall back to private local disk storage
# (development and tests). The bucket is created as a private bucket on first
# upload if it does not exist and the key allows bucket creation.
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=kodewar-hrms-documents

# Optional: temporary DDL-capable database account used only by
# `npm run migrate:documents` when the application account cannot CREATE tables.
# Remove these after the migration has run.
# DB_ADMIN_USER=your-admin-db-user
# DB_ADMIN_PASSWORD=your-admin-db-password
