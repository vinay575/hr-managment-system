{
  "name": "aurora-hrms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aurora HR — a beautiful full-stack HR management system",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/src/index.js",
    "dev:web": "vite",
    "test": "npm run test:api && npm run test:browser",
    "test:api": "vitest run",
    "test:api:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "seed": "node server/src/seed.js",
    "migrate:roles": "node server/src/migrate-roles.js",
    "migrate:recruitment": "node server/src/migrate-recruitment.js",
    "migrate:phase3": "node server/src/migrate-phase3.js",
    "migrate:expenses": "node server/src/migrate-expenses.js",
    "migrate:performance": "node server/src/migrate-performance.js",
    "migrate:notifications": "node server/src/migrate-notifications.js",
    "build": "vite build",
    "start": "node server/src/index.js",
    "preview": "vite preview",
    "install:all": "npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "multer": "^2.5.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vitest": "^5.0.5"
  }
}
